    "pops = {}\n",
    "pops[\"exo\"] = TransitingExoplanets()\n",
    "pops[\"solarsystem\"] = SolarSystem()\n",
    "for k, p in preset_maps.items():\n",
    "    print(k, p)\n",
    "    p().build(pops=pops)\n",
    "    plt.title(f\"Map={k}\")"
