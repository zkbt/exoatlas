XV7jjdF"},{"type":"text","value":") is smaller than that expected precision, it’s basically hopeless that we’ll see anything. So, let’s at least limit our sample to targets with a reasonably high predicted signal-to-noise ratio.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"dmmCuY1Yst"}],"key":"SBBEinhCcl"}],"key":"lDzdsUWVoQ"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"import matplotlib.pyplot as plt\nimport numpy as np\n\nsignal = e.transmission_signal()\nwavelength = 0.7 * u.micron\ndt = 1 * u.hour\nR = 10\nnoise = e.depth_uncertainty(telescope=\"APO\", wavelength=wavelength, dt=dt, R=R)\nsnr = signal / noise\n\nplt.figure(figsize=(8, 5))\nplt.scatter(noise, signal, c=snr, vmin=1, vmax=10)\nplt.xscale(\"log\")\nplt.yscale(\"log\")\nplt.axis(\"scaled\")\nplt.xlabel(\"\")\nplt.ylim(1e-6, 1e-2)\nplt.xlim(1e-6, 1e-2)\nplt.plot(\n    [1e-6, 1e-2], [1e-6, 1e-2], color=\"black\", linewidth=3, linestyle=\"--\", alpha=0.3\n)\nplt.colorbar(label=\"S/N\")\nplt.xlabel(rf\"Predicted Photon Noise\\n($\\lambda=${wavelength}, dt={dt}, R={R})\")\nplt.ylabel(r\"Possible Transmission\\nSignal Size ($2HR_p/R_{\\star}^2$)\");","key":"crBPwPIlqW"},{"type":"outputs","id":"Ecd7CQUUMI9Mwd_7Fs1X7","children":[{"type":"output","children":[],"jupyter_data":{"output_type":"display_data","metadata":{},"data":{"text/plain":{"content":"<Figure size 800x500 with 2 Axes>","content_type":"text/plain"},"image/png":{"content_type":"image/png","hash":"eee80d3023bf72d9a5c7d7e37c71f7e2","path":"/exoatlas/build/eee80d3023bf72d9a5c7d7e37c71f7e2.png"}}},"key":"cwKJjd7Zw3"}],"key":"mA2DZHmJ7U"}],"key":"prPCKmZ8Uf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"is_snr = snr > 5\nfiltered = e[is_snr]\nfiltered.label = \"High S/N\"\nfiltered","key":"gAegLbVTGw"},{"type":"outputs","id":"1CYmEzmOc6BmqF9OJSsJ1","children":[{"type":"output","children":[]